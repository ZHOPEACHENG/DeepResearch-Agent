# ═══════════════════════════════════════════════════════════════════
# LLM — Model Selection
# ═══════════════════════════════════════════════════════════════════
LLM_MODEL=gpt-4o
LLM_EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o
SUMMARIZATION_MODEL=gpt-4o-mini
SUMMARIZATION_MODEL_MAX_TOKENS=1024
MAX_CONTENT_LENGTH=50000
MAX_CONTEXT_TOKENS=128000
AVAILABLE_MODELS=["gpt-4o","gpt-4o-mini","claude-sonnet-4-6","claude-opus-4-8"]

# Per-agent model overrides (leave empty to fall back to LLM_MODEL above)
# PLANNER_MODEL=
# ANALYZER_MODEL=
# WRITER_MODEL=

# Provider API keys — one per provider you intend to use.
# init_chat_model auto-detects the provider from the model name.
OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
ANTHROPIC_API_KEY=sk-your-anthropic-key

# ═══════════════════════════════════════════════════════════════════
# Search API
# ═══════════════════════════════════════════════════════════════════
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-search-api-key

# ═══════════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════════
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=research_dev
POSTGRES_DB=deepresearch
POSTGRES_PORT=5432

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=research_dev
MONGO_DB=deepresearch
MONGO_PORT=27017

ES_PORT=9200

# ═══════════════════════════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════════════════════════
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══════════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════════
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

MAX_TASK_EXECUTION_SECONDS=7200
MAX_CONCURRENT_TASKS_PER_USER=3
MAX_GAP_ROUNDS=3
