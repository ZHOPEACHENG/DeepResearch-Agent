# ═══════════════════════════════════════════════════════════════════
# LLM API Configuration (Required)
# ═══════════════════════════════════════════════════════════════════
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o

# Model split — different tasks can use different-sized models.
# summarization_model: cheap/fast model for webpage summarization.
# planner/analyzer/writer_model: override the agent-specific model
#   (leave empty to fall back to LLM_MODEL).
SUMMARIZATION_MODEL=gpt-4o-mini
SUMMARIZATION_MODEL_MAX_TOKENS=1024
MAX_CONTENT_LENGTH=50000
PLANNER_MODEL=
ANALYZER_MODEL=
WRITER_MODEL=

MAX_CONTEXT_TOKENS=128000
# Comma-separated list of models available in the UI selector
AVAILABLE_MODELS=["gpt-4o","gpt-4o-mini","claude-sonnet-4-6","claude-opus-4-8"]

# ═══════════════════════════════════════════════════════════════════
# Search API Configuration (Required)
# ═══════════════════════════════════════════════════════════════════
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-search-api-key

# ═══════════════════════════════════════════════════════════════════
# Database Credentials (Optional — change in production)
# ═══════════════════════════════════════════════════════════════════
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=research_dev
POSTGRES_DB=deepresearch
POSTGRES_PORT=5432

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=research_dev
MONGO_DB=deepresearch
MONGO_PORT=27017

ES_PORT=9200

# ═══════════════════════════════════════════════════════════════════
# JWT Configuration (IMPORTANT: change in production!)
# ═══════════════════════════════════════════════════════════════════
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══════════════════════════════════════════════════════════════════
# Application Configuration
# ═══════════════════════════════════════════════════════════════════
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

# Maximum task execution time in seconds (2 hours)
MAX_TASK_EXECUTION_SECONDS=7200
# Maximum concurrent running tasks per user
MAX_CONCURRENT_TASKS_PER_USER=3
# Maximum ReAct analysis iterations (AnalyzerAgent tool-calling loop)
MAX_ANALYZER_ITERATIONS=5

# Deprecated — the outer gap_loop has been removed; gap detection is now
# internal to the Analyzer's ReAct loop. Kept for .env compatibility only.
MAX_GAP_ROUNDS=3
