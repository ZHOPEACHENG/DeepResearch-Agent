# ═══════════════════════════════════════════════════════════════════
# LLM — Provider API Keys
# ═══════════════════════════════════════════════════════════════════
# init_chat_model auto-detects provider from model name.
# Set the key(s) for the provider(s) you intend to use.
OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
ANTHROPIC_API_KEY=sk-your-anthropic-key

# ═══════════════════════════════════════════════════════════════════
# LLM — Model Selection
# ═══════════════════════════════════════════════════════════════════
LLM_MODEL=deepseek-v4-flash
LLM_EMBED_MODEL=text-embedding-v4
CHAT_MODEL=deepseek-v4-flash
SUMMARIZATION_MODEL=deepseek-v4-flash
SUMMARIZATION_MODEL_MAX_TOKENS=1024
MAX_CONTENT_LENGTH=50000
MAX_CONTEXT_TOKENS=128000
AVAILABLE_MODELS=["deepseek-v4-flash","gpt-4o","gpt-4o-mini","claude-sonnet-4-6"]

# Per-agent model overrides (leave empty to fall back to LLM_MODEL)
# PLANNER_MODEL=
# ANALYZER_MODEL=
# WRITER_MODEL=

# Deep thinking — reasoning models keep thinking mode active.
# WARNING: thinking mode rejects tool_choice — agents using
# with_structured_output() (planner, analyzer, writer) will fail.
LLM_DEEP_THINKING=false

# Chat/LLM API base URL (shared default for all models).
# Leave empty for official endpoints; set for proxies / compatible APIs.
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek direct: https://api.deepseek.com/v1
BASE_URL=

# Embedding API — dedicated endpoint and key.
# Falls back to BASE_URL / OPENAI_API_KEY when empty.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# Search API
# ═══════════════════════════════════════════════════════════════════
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=tvly-your-tavily-key

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL
# ═══════════════════════════════════════════════════════════════════
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=research_dev
POSTGRES_DB=deepresearch

# ═══════════════════════════════════════════════════════════════════
# MongoDB
# ═══════════════════════════════════════════════════════════════════
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=research_dev
MONGO_DB=deepresearch

# ═══════════════════════════════════════════════════════════════════
# Elasticsearch
# ═══════════════════════════════════════════════════════════════════
ES_HOST=localhost
ES_PORT=9200

# ═══════════════════════════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════════════════════════
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══════════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════════
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
MAX_TASK_EXECUTION_SECONDS=7200
MAX_CONCURRENT_TASKS_PER_USER=3
MAX_GAP_ROUNDS=3

# ═══════════════════════════════════════════════════════════════════
# Upload / Knowledge Base
# ═══════════════════════════════════════════════════════════════════
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ═══════════════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════════════
CORS_ORIGINS=["http://localhost:3000"]
